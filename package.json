{
  "name": "dakar-bus",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:data": "python3 -m unittest discover -s tests -v",
    "test:all": "npm test && npm run test:data",
    "reference:gtfs": "python3 tools/build_reference_gtfs.py --out data/reference/dakar-bus-reference.zip",
    "validate:gtfs": "python3 scripts/validate_gtfs.py",
    "stage:gtfs": "python3 scripts/stage_gtfs.py",
    "catalog:gtfs": "python3 scripts/catalog_gtfs.py",
    "actors": "python3 scripts/actor_registry.py --root data/actors",
    "review:gtfs": "python3 scripts/review_gtfs.py",
    "publish:gtfs": "python3 scripts/publish_gtfs.py",
    "admin:api": "python3 scripts/serve_admin_api.py --root data/staging --published-root data/published --actors-root data/actors --host 127.0.0.1 --port 8787",
    "graph:build": "python3 scripts/publish_gtfs.py --published-root data/published graph-rebuild",
    "graph:status": "python3 scripts/publish_gtfs.py --published-root data/published graph-status"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/leaflet": "^1.9.16",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^28.1.0",
    "typescript": "~5.6.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
